+def _ollama_context(settings: Settings, legacy_ctx: int | None, role: str = "primary") -> int | None:
+    """Resolve effective Ollama context for a role.
+
+    Large contexts improve long agent/coding tasks but also increase runner
+    startup memory. Role-specific defaults keep tool and verifier calls from
+    accidentally paying the full 64k+ load cost unless explicitly requested.
+    """
+    role_attr = f"OLLAMA_{role.upper()}_CTX_LEN"
+    role_value = getattr(settings, role_attr, None)
+    return int(role_value or getattr(settings, "OLLAMA_CTX_LEN", None) or legacy_ctx or 32768)
 
 
