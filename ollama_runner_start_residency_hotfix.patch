+@router.post("/health/ollama-agent-prewarm", tags=["health"])
+async def ollama_agent_prewarm(roles: str = Query(default="", description="Comma-separated model roles to prewarm; defaults to OLLAMA_PREWARM_ROLES")) -> dict[str, Any]:
