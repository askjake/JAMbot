+async def _ollama_prewarm_roles(role_names: list[str]) -> dict[str, Any]:
+    """Warm selected Ollama role models with a tiny request.
+
+    This deliberately does not pull missing models. It only calls /api/chat for
+    models already present in /api/tags so cold runner startup happens before a
+    user-facing SSE stream.
+    """
+    try:
+        import httpx
+    except Exception as exc:
+        return {"status": "fail", "error": f"httpx unavailable: {exc}", "results": []}
+
+    settings = get_settings()
+    roles = resolve_all_model_roles(settings=settings)
+    base_url = (settings.PLLM_API_BASE or settings.ELLM_API_BASE or "http://127.0.0.1:11434").rstrip("/")
+    timeout = float(getattr(settings, "OLLAMA_CLIENT_TIMEOUT", 600.0) or 600.0)
+    keep_alive_default = getattr(settings, "OLLAMA_KEEP_ALIVE", "1h")
+    max_predict = int(getattr(settings, "OLLAMA_PREWARM_MAX_OUTPUT_TOKENS", 1) or 1)
+    reachability = await _ollama_reachability(base_url)
+    local_models = set(reachability.get("models", []))
+    results: list[dict[str, Any]] = []
+
+    async with httpx.AsyncClient(timeout=timeout) as client:
+        for role_name in role_names:
+            role_name = role_name.strip()
+            if not role_name:
+                continue
+            cfg = roles.get(role_name)
+            if not cfg:
+                results.append({"role": role_name, "status": "fail", "error": "unknown role"})
+                continue
+            if cfg.provider != "ollama":
+                results.append({"role": role_name, "status": "skipped", "reason": f"provider={cfg.provider}"})
+                continue
+            if cfg.model_name not in local_models:
+                results.append({"role": role_name, "model": cfg.model_name, "status": "fail", "error": "model not present in /api/tags; prewarm will not pull"})
+                continue
+            payload = {
+                "model": cfg.model_name,
+                "messages": [{"role": "user", "content": "Reply with OK."}],
+                "stream": False,
+                "keep_alive": cfg.keep_alive or keep_alive_default,
+                "options": {
+                    "num_ctx": cfg.context_length,
+                    "num_predict": max_predict,
+                    "temperature": 0,
+                },
+            }
+            try:
+                response = await client.post(base_url + "/api/chat", json=payload)
+                data = response.json() if response.headers.get("content-type", "").startswith("application/json") else {"raw": response.text[:500]}
+                results.append({
+                    "role": role_name,
+                    "model": cfg.model_name,
+                    "context_length": cfg.context_length,
+                    "keep_alive": cfg.keep_alive or keep_alive_default,
+                    "status_code": response.status_code,
+                    "status": "pass" if response.status_code < 400 else "fail",
+                    "load_duration_ms": int(data.get("load_duration", 0) / 1_000_000) if isinstance(data, dict) else None,
+                    "total_duration_ms": int(data.get("total_duration", 0) / 1_000_000) if isinstance(data, dict) else None,
+                    "done_reason": data.get("done_reason") if isinstance(data, dict) else None,
+                    "error": data.get("error") if isinstance(data, dict) else None,
+                })
+            except Exception as exc:
+                results.append({"role": role_name, "model": cfg.model_name, "status": "fail", "error": str(exc)})
+    return {"status": "pass" if all(r.get("status") in {"pass", "skipped"} for r in results) else "fail", "base_url": base_url, "results": results}
+
