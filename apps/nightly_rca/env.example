# ── Safety mode ─────────────────────────────────────────────────────────────
# Default is read/preview only. Live writes require BOTH values to be true.
NIGHTLY_RCA_COMMIT=false
NIGHTLY_RCA_WRITE_AUTHORIZED=false
NIGHTLY_RCA_ROLE=operator

# ── MCP transport ───────────────────────────────────────────────────────────
NIGHTLY_RCA_AWS_REGION=us-west-2
NIGHTLY_RCA_S3_MCP_URL=
NIGHTLY_RCA_RTR_MCP_URL=
NIGHTLY_RCA_GRASSHOPPER_MCP_URL=

# ── Run storage and cron wrapper ─────────────────────────────────────────────
NIGHTLY_RCA_OUTPUT_DIR=/tmp/nightly_rca_v6
NIGHTLY_RCA_LOG_DIR=/home/jakebot/Jakes-agent/logs/nightly_rca
NIGHTLY_RCA_LOCK_FILE=/tmp/nightly_rca_v6.lock
NIGHTLY_RCA_MAX_SECONDS=5400
NIGHTLY_RCA_VENV=/home/jakebot/Jakes-agent/.venv
NIGHTLY_RCA_QUEUE_ID=main

# ── Bounded workload ────────────────────────────────────────────────────────
NIGHTLY_RCA_DISCOVERY_HOURS=24
NIGHTLY_RCA_MAX_UNRESOLVED=10
NIGHTLY_RCA_MAX_CLUSTERS=20
NIGHTLY_RCA_MAX_PROFILES=10
NIGHTLY_RCA_MAX_CASES=10
NIGHTLY_RCA_MAX_UPLOAD_FILES=50
NIGHTLY_RCA_MATERIALIZER_SECONDS=45
NIGHTLY_RCA_HISTORY_RUNS=14
NIGHTLY_RCA_PENDING_BATCH_SIZE=25
NIGHTLY_RCA_TEST_RECEIVER=R0000000001

# ── Optional T2I Log Atlas v3 observability ──────────────────────────────────
# Candidate A is the frozen blind-benchmark winner. Keep disabled until
# D1/D2 holdout and live acceptance are complete.
NIGHTLY_RCA_T2I_ATLAS_ENABLED=false
NIGHTLY_RCA_T2I_ATLAS_PROFILE=candidate_a
# D0-frozen production font provenance. Update only with a fresh visual holdout.
NIGHTLY_RCA_T2I_ATLAS_FONT_SHA256=39c29931201f08dd89fdba4129c76288e6baeecf7c94fe4f6a757f2b50718b1b
NIGHTLY_RCA_T2I_ATLAS_FONT_BOLD_SHA256=f8aa70b5d4210d77624f5b5b5cf094fadf9fd019caf5b528fa5af42fc4ac43a5

# ── Qualified selective visual context (independent flag; default disabled) ──
# Server-owned explicit run_id + L#### locator materialization only. This is
# intentionally separate from the legacy whole-run observability atlas switch.
NIGHTLY_RCA_T2I_SELECTIVE_CONTEXT_ENABLED=false
# Fail-closed authorization: empty means nobody can request server-owned RCA evidence.
NIGHTLY_RCA_T2I_SELECTIVE_ALLOWED_EMAILS=
NIGHTLY_RCA_T2I_RUNS_ROOT=/home/jakebot/Jakes-agent/var/nightly_rca_v6/runs
NIGHTLY_RCA_T2I_SELECTIVE_MAX_EVENTS=5

# ── Optional notification ───────────────────────────────────────────────────
NIGHTLY_RCA_NOTIFY=true
NIGHTLY_RCA_WEBHOOK=
NIGHTLY_RCA_RECIPIENTS=jacob.montgomery@dish.com
