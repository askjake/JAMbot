# ServiceNow MCP Server — Environment Variables
# Copy this file to .env and fill in your values

# ServiceNow instance URL (no trailing slash)
SNOW_INSTANCE_URL=https://dish.service-now.com

# Auth mode: "oauth" or "basic"
SNOW_AUTH_MODE=oauth

# OAuth 2.0 Client Credentials (required when SNOW_AUTH_MODE=oauth)
SNOW_CLIENT_ID=
SNOW_CLIENT_SECRET=

# Basic Auth (required when SNOW_AUTH_MODE=basic)
SNOW_USERNAME=
SNOW_PASSWORD=

# Server bind address and port
SNOW_MCP_HOST=127.0.0.1
SNOW_MCP_PORT=8095
