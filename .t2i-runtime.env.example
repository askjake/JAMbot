# Guarded T2I runtime persistence example.
# Copy to .t2i-runtime.env, keep mode 0600, and do not commit the local file.
# D3H/D3N qualification covers selective context only; legacy full-atlas
# model ingress must remain disabled.
NIGHTLY_RCA_T2I_ATLAS_ENABLED=false
NIGHTLY_RCA_T2I_SELECTIVE_CONTEXT_ENABLED=true
NIGHTLY_RCA_T2I_SELECTIVE_ALLOWED_EMAILS=test.test@dish.com
NIGHTLY_RCA_T2I_SELECTIVE_MAX_EVENTS=5
NIGHTLY_RCA_T2I_RUNS_ROOT=/home/jakebot/Jakes-agent/var/nightly_rca_v6/runs
