diff --git a/tests/test_content_type_meta_hints.py b/tests/test_content_type_meta_hints.py
new file mode 100644
index 0000000..a010c1a
--- /dev/null
+++ b/tests/test_content_type_meta_hints.py
@@ -0,0 +1,65 @@
+"""Tests for MCP content-type hints used by chat-side compression."""
+
+from __future__ import annotations
+
+import inspect
+
+from app.response_compaction import compact_mcp_response, mcp_content_meta
+from app import token_efficient_validation
+
+
+def test_mcp_content_meta_shape() -> None:
+    meta = mcp_content_meta(
+        "json_report",
+        tool_name="validate_mcp_token_efficiency",
+        compression_hint="preserve_validation_keys_drop_large_arrays",
+    )
+
+    assert meta == {
+        "content_type": "json_report",
+        "tool_name": "validate_mcp_token_efficiency",
+        "compression_hint": "preserve_validation_keys_drop_large_arrays",
+    }
+
+
+def test_compact_response_includes_json_report_meta_without_persistence() -> None:
+    payload = {
+        "ok": True,
+        "cases": [{"id": idx, "status": "passed"} for idx in range(12)],
+        "summary": {"passed": 12},
+    }
+
+    compact = compact_mcp_response(
+        None,
+        payload,
+        artifact_kind="unit_validation_report",
+        persist_full_report=False,
+        max_inline_items=3,
+    )
+
+    assert compact["_meta"]["content_type"] == "json_report"
+    assert compact["_meta"]["tool_name"] == "unit_validation_report"
+    assert compact["_meta"]["compression_hint"] == "preserve_json_keys_drop_large_arrays"
+    assert compact["compact_response"] is True
+    assert compact["cases_omitted"] == 12
+
+
+def test_validate_token_efficiency_tool_registers_json_report_meta() -> None:
+    source = inspect.getsource(token_efficient_validation.register_token_efficient_validation_tools)
+
+    assert "mcp_content_meta" in source
+    assert "json_report" in source
+    assert "validate_mcp_token_efficiency" in source
+    assert "preserve_validation_keys_drop_large_arrays" in source
+
+
+def test_server_tool_responses_include_content_type_hints() -> None:
+    server_source = (token_efficient_validation.__file__.rsplit('/app/', 1)[0] + '/app/server.py')
+    with open(server_source, 'r', encoding='utf-8') as handle:
+        source = handle.read()
+
+    assert '_mcp_content_meta("stb_log", tool_name="read_log"' in source
+    assert '_mcp_content_meta("stb_log", tool_name="filter_log_lines"' in source
+    assert '_mcp_content_meta("json_report", tool_name="search_logs"' in source
+    assert '_mcp_content_meta("json_report", tool_name="get_tool_info"' in source
+    assert 'compression_hint="heavy_tool_policy"' in source
