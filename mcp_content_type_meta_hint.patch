+def mcp_content_meta(content_type: str, *, tool_name: str = "", compression_hint: str = "") -> dict[str, Any]:
+    """Return a standard MCP response metadata block for client-side compression.
+
+    The chat-agent compression layer uses this hint to dispatch large ToolMessage
+    payloads without guessing whether a response is raw STB log text, a JSON
+    metadata report, browser/HTML content, or plain text.
+    """
+
+    meta = {"content_type": content_type}
+    if tool_name:
+        meta["tool_name"] = tool_name
+    if compression_hint:
+        meta["compression_hint"] = compression_hint
+    return meta
+
